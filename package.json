{
  "name": "ayla-tools-compact",
  "version": "0.1.0-beta.1",
  "description": "Compact one-line rendering for Pi's built-in tools (bash, read, grep, find, ls). Rendering-only extension: execution stays in Pi.",
  "type": "module",
  "license": "MIT",
  "author": "kekma-dot",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "rendering"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "assets/",
    "LICENSE",
    "README.md",
    "README.ru.md",
    "provenance.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekma-dot/ayla-tools-compact.git"
  },
  "bugs": {
    "url": "https://github.com/kekma-dot/ayla-tools-compact/issues"
  },
  "homepage": "https://github.com/kekma-dot/ayla-tools-compact#readme"
}
